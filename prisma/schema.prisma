// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum ItemType {
  PLACE
  RESTAURANT
  HOTEL
  TRANSPORT
  CUSTOM
}

enum TravelMode {
  WALK
  TRANSIT
  DRIVE
  BIKE
}

enum CostCategory {
  TRANSPORT
  FOOD
  LODGING
  TICKET
  SHOPPING
  OTHER
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  avatarUrl     String?
  googleUid     String?        @unique
  trips         Trip[]
  collaborating Collaborator[]
  favorites     Favorite[]
  createdAt     DateTime       @default(now())
}

// A personal bucket-list, independent of any specific trip — "我的收藏".
// Not shared with trip collaborators; scoped to whichever user saved it.
model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  place     Place    @relation(fields: [placeId], references: [id])
  placeId   String
  createdAt DateTime @default(now())

  @@unique([userId, placeId])
}

// AI-generated review digest for a place, keyed independently of Place
// (not every previewed place gets added/favorited, so this shouldn't
// force a full Place row into existence just to cache a summary).
// Generated once per place and reused — no per-view cost after the first.
model PlaceInsight {
  id         String   @id @default(cuid())
  provider   String
  externalId String
  summary    String
  createdAt  DateTime @default(now())

  @@unique([provider, externalId])
}

// Rate-limits AI calls per user (see getPlaceInsight) — anyone with an
// account can otherwise call the AI summary action directly with
// arbitrary "review" text and no trip context, effectively getting free
// LLM generation billed to this project's AI Gateway account. One row per
// actual generation attempt (not per cache hit).
model AiUsageLog {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Trip {
  id            String         @id @default(cuid())
  owner         User           @relation(fields: [ownerId], references: [id])
  ownerId       String
  title         String
  startDate     DateTime
  endDate       DateTime
  coverImage    String?
  status        String         @default("planning") // planning | confirmed | archived
  emergencyInfo String? // passport copy location, insurance policy #, emergency contacts, ...
  days          TripDay[]
  collaborators Collaborator[]
  createdAt     DateTime       @default(now())
}

model Collaborator {
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())

  @@id([tripId, userId])
}

model TripDay {
  id       String   @id @default(cuid())
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId   String
  date     DateTime
  dayIndex Int
  note     String?
  items    Item[]
  routes   Route[]

  // The item that represents this day's "start from" point (e.g. the
  // hotel) — a real timeline card (so it gets a photo, editable time/cost,
  // and a real computed leg to the next stop via the normal auto-fill
  // effect), but tracked here so optimizeStopOrder knows to keep it first
  // instead of reordering it away, and so the anchor UI can find/update it.
  anchorItem   Item?   @relation("TripDayAnchorItem", fields: [anchorItemId], references: [id])
  anchorItemId String? @unique
}

model Item {
  id                 String        @id @default(cuid())
  day                TripDay       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId              String
  type               ItemType
  place              Place?        @relation(fields: [placeId], references: [id])
  placeId            String?
  startTime          DateTime?
  endTime            DateTime?
  sortOrder          Int
  note               String?
  confirmationNumber String? // hotel booking ref, flight PNR, ticket number, ...
  cost               Float?
  currency           String? // "TWD" | "JPY" | "USD" | ...
  costCategory       CostCategory?

  routesFrom Route[] @relation("RouteFrom")
  routesTo   Route[] @relation("RouteTo")

  anchorForDay TripDay? @relation("TripDayAnchorItem")
}

model Place {
  id            String     @id @default(cuid())
  name          String
  category      String
  country       String // "TW" | "JP" | ...
  address       String?
  lat           Float
  lng           Float
  rating        Float?
  priceLevel    Int?
  openHours     String? // JSON: OpeningPeriod[] from src/lib/businessHours.ts
  photoUrl      String?
  provider      String // "google" | "hotpepper" | "tdx" | ...
  externalId    String
  // "PLACE" | "RESTAURANT" — Google's raw category (primaryType) that fed
  // this classification isn't stored anywhere else, so without persisting
  // it here, re-adding a place from "我的收藏" would lose the distinction
  // search already made and always default to PLACE.
  suggestedType String?
  items         Item[]
  favoritedBy   Favorite[]

  @@unique([provider, externalId])
}

model Route {
  id          String     @id @default(cuid())
  day         TripDay    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId       String
  fromItem    Item       @relation("RouteFrom", fields: [fromItemId], references: [id], onDelete: Cascade)
  fromItemId  String
  toItem      Item       @relation("RouteTo", fields: [toItemId], references: [id], onDelete: Cascade)
  toItemId    String
  mode        TravelMode
  country     String // "TW" | "JP" | ...
  provider    String // "google" | "tdx" | "ekispert" | ...
  durationMin Int?
  distanceKm  Float?
  fare        Float?
  rawPolyline String?
}
