// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum ItemType {
  PLACE
  RESTAURANT
  HOTEL
  TRANSPORT
  CUSTOM
}

enum TravelMode {
  WALK
  TRANSIT
  DRIVE
  BIKE
  FLY
}

enum CostCategory {
  TRANSPORT
  FOOD
  LODGING
  TICKET
  SHOPPING
  OTHER
}

enum ChecklistCategory {
  DOCUMENT
  TRANSPORT
  ACCOMMODATION
  MONEY
  INTERNET
  LUGGAGE
  HEALTH
  TICKET
  CUSTOM
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  avatarUrl         String?
  googleUid         String?            @unique
  trips             Trip[]
  collaborating     Collaborator[]
  favorites         Favorite[]
  checklistDone     ChecklistItem[]    @relation("ChecklistDoneBy")
  checklistAssigned ChecklistItem[]    @relation("ChecklistAssignedTo")
  pushSubscriptions PushSubscription[]
  createdAt         DateTime           @default(now())
}

// A personal bucket-list, independent of any specific trip — "我的收藏".
// Not shared with trip collaborators; scoped to whichever user saved it.
model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  place     Place    @relation(fields: [placeId], references: [id])
  placeId   String
  createdAt DateTime @default(now())

  @@unique([userId, placeId])
}

// AI-generated fit assessment for a place, keyed independently of Place
// (not every previewed place gets added/favorited, so this shouldn't force
// a full Place row into existence just to cache a result). Scoped per
// (place, day) rather than globally per place — fitScore/suggestedDuration
// are judged against that specific day's already-planned itinerary, so the
// same place can score differently for a relaxed day vs. a packed one.
// tripId/dayId are plain ids (no relation) like AiUsageLog.userId below —
// this is disposable analysis cache, not data that needs referential
// integrity with Trip/TripDay.
model PlaceInsight {
  id                String   @id @default(cuid())
  provider          String
  externalId        String
  tripId            String
  dayId             String
  summary           String
  fitScore          Int // 0-100, how well this fits the day's existing itinerary
  suggestedDuration String
  caution           String?
  createdAt         DateTime @default(now())

  @@unique([provider, externalId, dayId])
}

// Rate-limits AI calls per user (see getPlaceInsight) — anyone with an
// account can otherwise call the AI summary action directly with
// arbitrary "review" text and no trip context, effectively getting free
// LLM generation billed to this project's AI Gateway account. One row per
// actual generation attempt (not per cache hit).
model AiUsageLog {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Trip {
  id            String         @id @default(cuid())
  owner         User           @relation(fields: [ownerId], references: [id])
  ownerId       String
  title         String
  startDate     DateTime
  endDate       DateTime
  coverImage    String?
  status        String         @default("planning") // planning | confirmed | archived
  emergencyInfo String? // passport copy location, insurance policy #, emergency contacts, ...
  days          TripDay[]
  collaborators Collaborator[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  // Share-link invite: anyone with a valid, currently-enabled token who
  // visits /trips/[id]?share=[shareToken] while signed in is auto-added as
  // a real Collaborator with role `shareRole` (see src/app/trips/[id]/page.tsx)
  // — a lower-friction alternative to the owner typing an exact email into
  // addCollaborator. Requiring sign-in (rather than truly anonymous access)
  // keeps every edit attributable to a real account and needs no changes to
  // the existing per-action role checks. Disabling/re-enabling rotates
  // shareToken, so a leaked link can be invalidated without affecting
  // collaborators already added.
  shareEnabled Boolean @default(false)
  shareToken   String? @unique
  shareRole    Role?

  // Separate from the collaborator share link above — this one is for the
  // read-only "旅遊書" (travel scrapbook) page, meant to be sent to family
  // and friends who don't have (and shouldn't need) an account just to
  // look at photos and stories. No role, no auto-join-as-collaborator: the
  // public /journal/[token] page never touches auth at all, it just
  // checks this flag + token directly.
  journalShareEnabled Boolean @default(false)
  journalShareToken   String? @unique

  checklistItems ChecklistItem[]

  @@index([ownerId])
}

model Collaborator {
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())

  @@id([tripId, userId])
}

model TripDay {
  id       String   @id @default(cuid())
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId   String
  date     DateTime
  dayIndex Int
  note     String?
  items    Item[]
  routes   Route[]

  // The item that represents this day's "start from" point (e.g. the
  // hotel) — a real timeline card (so it gets a photo, editable time/cost,
  // and a real computed leg to the next stop via the normal auto-fill
  // effect), but tracked here so optimizeStopOrder knows to keep it first
  // instead of reordering it away, and so the anchor UI can find/update it.
  anchorItem   Item?   @relation("TripDayAnchorItem", fields: [anchorItemId], references: [id])
  anchorItemId String? @unique

  @@index([tripId])
}

model Item {
  id                 String        @id @default(cuid())
  day                TripDay       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId              String
  type               ItemType
  place              Place?        @relation(fields: [placeId], references: [id])
  placeId            String?
  startTime          DateTime?
  endTime            DateTime?
  sortOrder          Int
  note               String?
  confirmationNumber String? // hotel booking ref, flight PNR, ticket number, ...
  // DEPRECATED (2026-07-15): single-cost fields superseded by the ItemCost
  // relation below (one item can carry ticket + meal + shopping entries).
  // Kept in the schema so `prisma db push` never drops the columns while
  // any pre-backfill data might still live only here — remove in a later
  // cleanup pass once ItemCost has been stable in prod. No code reads or
  // writes these anymore.
  cost               Float?
  currency           String? // "TWD" | "JPY" | "USD" | ...
  costCategory       CostCategory?
  costs              ItemCost[]
  // Longer-form story text for the "旅遊書" travel-book page — deliberately
  // separate from `note` above, which is short logistics scribbles written
  // while planning (gate codes, "arrive early"), not something meant to be
  // read by someone you're sharing photos with after the trip.
  journalText        String?
  photos             ItemPhoto[]
  // Drives the home page's "最後更新" (last updated) per trip — itinerary
  // edits (add/edit/reorder) touch Item rows far more often than the Trip
  // row itself, so Trip.updatedAt alone would look stale even right after
  // someone was actively editing.
  updatedAt          DateTime      @default(now()) @updatedAt

  routesFrom Route[] @relation("RouteFrom")
  routesTo   Route[] @relation("RouteTo")

  anchorForDay TripDay? @relation("TripDayAnchorItem")

  @@index([dayId])
}

// One expense line on an itinerary item — an item usually has more than
// one (entrance ticket + lunch + souvenirs at the same stop), which is why
// this replaced Item's deprecated single cost/currency/costCategory
// columns. `label` is optional free text ("午餐", "特展門票") so two
// entries of the same category stay distinguishable.
model ItemCost {
  id        String       @id @default(cuid())
  item      Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  label     String?
  amount    Float
  currency  String // "TWD" | "JPY" | ...
  category  CostCategory
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([itemId])
}

// User's own trip photos attached to a stop, for the "旅遊書" page — distinct
// from Place.photoUrl (a single stock photo from Google/hotpepper search
// results), since a journal needs the traveler's actual pictures, and more
// than one per stop.
model ItemPhoto {
  id        String   @id @default(cuid())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([itemId])
}

model Place {
  id            String     @id @default(cuid())
  name          String
  category      String
  country       String // "TW" | "JP" | ...
  address       String?
  lat           Float
  lng           Float
  rating        Float?
  priceLevel    Int?
  openHours     String? // JSON: OpeningPeriod[] from src/lib/businessHours.ts
  photoUrl      String?
  provider      String // "google" | "hotpepper" | "tdx" | ...
  externalId    String
  // "PLACE" | "RESTAURANT" — Google's raw category (primaryType) that fed
  // this classification isn't stored anywhere else, so without persisting
  // it here, re-adding a place from "我的收藏" would lose the distinction
  // search already made and always default to PLACE.
  suggestedType String?
  items         Item[]
  favoritedBy   Favorite[]

  @@unique([provider, externalId])
}

model Route {
  id          String     @id @default(cuid())
  day         TripDay    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId       String
  fromItem    Item       @relation("RouteFrom", fields: [fromItemId], references: [id], onDelete: Cascade)
  fromItemId  String
  toItem      Item       @relation("RouteTo", fields: [toItemId], references: [id], onDelete: Cascade)
  toItemId    String
  mode        TravelMode
  country     String // "TW" | "JP" | ...
  provider    String // "google" | "tdx" | "ekispert" | ...
  durationMin Int?
  distanceKm  Float?
  fare        Float?
  rawPolyline String?
}

// "旅遊檢查清單" — per-trip, auto-seeded from src/lib/checklistTemplates.ts
// (a generic template plus destination templates matched against whatever
// countries actually appear among the trip's Place items — there's no
// stored Trip.destination field, since that would just be a second source
// of truth for something already derivable from the places themselves).
model ChecklistItem {
  id           String            @id @default(cuid())
  trip         Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId       String
  title        String
  category     ChecklistCategory @default(CUSTOM)
  note         String?
  isDone       Boolean           @default(false)
  doneAt       DateTime?
  doneBy       User?             @relation("ChecklistDoneBy", fields: [doneById], references: [id])
  doneById     String?
  assignedTo   User?             @relation("ChecklistAssignedTo", fields: [assignedToId], references: [id])
  assignedToId String?
  dueDate      DateTime?
  sortOrder    Int               @default(0)
  // "DEFAULT" | "DESTINATION_TEMPLATE" | "USER" — where this item came
  // from. Only template-seeded rows carry a sourceKey; user-added items
  // always have sourceKey null (Postgres treats every null as distinct, so
  // the @@unique below only ever dedupes template rows against themselves,
  // never against each other's custom items).
  source       String?
  sourceKey    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([tripId, sourceKey])
  @@index([tripId, category])
  @@index([tripId, isDone])
}

// One row per browser/device push subscription (a user signed in on two
// phones gets two rows) — `endpoint` is the push service's per-subscription
// URL, globally unique by construction, so it's the natural dedupe key
// instead of a synthetic one. `p256dh`/`auth` are the subscription's public
// key and auth secret, both required by the Web Push protocol to encrypt
// the payload; neither is a secret we generate, they come from the
// browser's PushManager.subscribe() response.
model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
